# Copiar a .env y completar. .env NO se sube al repositorio.
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR@localhost:5432/comedor_db
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
MATCH_THRESHOLD=0.45
DUPLICATE_THRESHOLD=0.50
LIVENESS_THRESHOLD=0.50
